{
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@tksh/stln-codec": "jsr:@tksh/stln-codec@0.1.3"
  },
  "tasks": {
    "check": "deno check src/js/app.js src/js/tex-codec.js src/js/texture-core.js",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --allow-read tests/"
  },
  "fmt": {
    "exclude": [
      "src/js/app.js",
      "src/css/styles.css",
      "src/index.html",
      "src/stln/index.html"
    ]
  }
}
